# Object files
*.obj
*.OBJ

# Build logs (dosbox-x redirects upcase filenames in mounted dirs)
*.log
*.LOG
/build.log

# Linker output
*.map
*.exp

# Assembler listings (TASM /la output)
*.lst
*.LST

# Compiler / linker error files (Open Watcom wcc386 emits foo.ERR per source)
*.err
*.ERR

# Container build output
/out/

# Packaged release artifacts (rebuildable from `make build`)
/release/

# Precompiled Headers
*.pch

# Libraries
*.lib

# Shared objects (inc. Windows DLLs)
*.dll

# Executables
*.exe

# Exclusions
!binw/*.*
!examples/*.*
!l32/*.*
!pctest/*.*
